{
  "name": "yarnboard",
  "version": "0.0.1",
  "description": "App for making infinite consipiracy boards",
  "license": "GPL-3.0-or-later",
  "author": "gibbdev",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder"
  },
  "devDependencies": {
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@jitsi/robotjs": "^0.6.21",
    "electron": "^45.0.0"
  },
  "build": {
    "appId": "gibbdev.yarnboard"
  },
  "postinstall": "electron-builder install-app-deps",
  "allowScripts": {
    "electron@42.5.0": true,
    "@electron/build-tools@2.1.5": true,
    "@jitsi/robotjs@0.6.24": true
  }
}
